class Solution {
    public int removeDuplicates(int[] nums) {
        int n=nums.length;
        int slow=0,fast=0;
        while(fast<=n-1){
            if(nums[slow]==nums[fast]){
                fast++;
            }
            else{
                slow++;
                nums[slow]=nums[fast++];
            }
        }
        return slow+1;
    }
}
