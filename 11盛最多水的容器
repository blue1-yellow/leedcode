class Solution {
    public int maxArea(int[] height) {
        int n=height.length;
        int left=0,right=n-1;
        int area=0;
        while(left<right){
            if(height[left]<height[right]){
               area=Math.max(area,height[left]*(right-left));
               left++;
            }
            else{
                 area=Math.max(area,height[right]*(right-left));
                 right--;
            }
        }
        return area;
    }
}
